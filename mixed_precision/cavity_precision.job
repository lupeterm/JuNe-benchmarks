#!/bin/bash
#SBATCH --job-name=june-precision
#SBATCH --nodes=1
#SBATCH --gres=gpu:nvidia:1
#SBATCH --cpus-per-task=32
#SBATCH --time=03:00:00
#SBATCH --output=/storage/home/lupeterm/NeoFOAM/benchmarks/june/precision/%x-%N-%j.out
#
# JuNe's GPU assembly in reduced precision (test_cavity.cpp with CAVITY_PRECISION=1 ->
# JuNe.benchmark_precision): the momentum equation ddt + div + laplacian, scalar matrix, every JuNe GPU
# strategy, in every configuration of JuNe.jl src/precision.jl (whole assembly in fp64/fp32/fp16/bf16,
# one operator in fp32/bf16, each operator alone). Prints assembly, allocation, conversion and
# back-conversion times and the deviation of matrix and rhs from fp64.
#   sbatch --exclude=<non-H200 nodes> benchmarks/june/precision/cavity_precision.job
#   CASES="100" overrides the sizes.

CASES_DIR=${CASES_DIR:-/storage/home/lupeterm/nobackup/julia/view/base/mesh}
CASES=${CASES:-"50 100 150 200 250 300 350 400"}

cd /storage/home/lupeterm/NeoFOAM
source "${WM_PROJECT_DIR:-/storage/home/lupeterm/openfoam-OpenFOAM-v2412}/etc/bashrc"
case $(hostname -s) in
    *h100*) gpu=h100 ;;
    *h200*) gpu=h200 ;;
    *) gpu=$(hostname -s) ;;
esac
out="benchmarks/june/precision/results/$gpu"
mkdir -p "$out"

# cases of the 50^3 sweep that have no mesh yet (250^3, 350^3: copies of the 260^3 case with the cell
# count changed in blockMeshDict) are meshed here
for n in $CASES; do
    case_dir="$CASES_DIR/$n/case"
    if [ ! -f "$case_dir/constant/polyMesh/owner" ] && [ -f "$case_dir/system/blockMeshDict" ]; then
        echo "=== blockMesh ${n}^3, $(date)"
        blockMesh -case "$case_dir" > "$case_dir/blockMesh.log" 2>&1 || { echo "blockMesh $n failed"; exit 1; }
    fi
done

./xbuild.sh gpu
bin="$PWD/build/julia-$(hostname -s)-gpu/bin/tests/cavity"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv | tee "$out/gpu.txt"

export JUNE_MODULE_INIT=/storage/home/lupeterm/JuNe.jl/init.jl JULIA_NUM_THREADS=1
# the precision changes touch JuNe's production GPU path: its tests must pass first
echo "=== JuNe GPU tests, $(date)"
(cd "build/julia-$(hostname -s)-gpu" && ctest -R "juneStrategies|junePiso|juneCellBasedTypes" --output-on-failure) \
    > "$out/june_tests.log" 2>&1 && echo "JuNe tests passed" || { echo "JuNe tests FAILED, see $out/june_tests.log"; exit 1; }
export CAVITY_MATRIX=scalar CAVITY_PRECISION=1 CAVITY_DDT=1
for n in $CASES; do
    case_dir="$CASES_DIR/$n/case"
    [ -f "$case_dir/constant/polyMesh/owner" ] || { echo "skip $n: no mesh"; continue; }
    echo "=== ${n}^3, $(date)"
    (cd "$case_dir" && "$bin") > "$out/cavity_$n.log" 2>&1 || echo "case $n failed, see $out/cavity_$n.log"
    grep -E "^Precision deviation|All tests|FAILED" "$out/cavity_$n.log"
done
echo "done $(date)"
