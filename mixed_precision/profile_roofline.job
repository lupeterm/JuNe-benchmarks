#!/bin/bash
#SBATCH --job-name=june-roofline
#SBATCH --nodes=1
#SBATCH --gres=gpu:nvidia:1
#SBATCH --cpus-per-task=32
#SBATCH --time=02:00:00
#SBATCH --output=/storage/home/lupeterm/NeoFOAM/benchmarks/june/precision/%x-%N-%j.out
#
# Roofline data for JuNe's whole-assembly precision configurations: the momentum equation ddt + div +
# laplacian on the 400^3 cavity, scalar matrix, JuNe face-based, cell-based and batched in fp64, fp32,
# fp16 and bf16 (test_cavity.cpp with CAVITY_PRECISION=1 -> JuNe.benchmark_precision, only these
# configurations: PRECISION_CONFIGS). Nsight Compute profiles every kernel inside the NVTX ranges
# "precision <strategy> <configuration>" (one reset + assembly per configuration, untimed) with the
# FLOP counts (fp64/fp32/fp16 add, mul, fma), the DRAM and L2 bytes and the device peaks.
#   sbatch --nodelist=gpu-nvidia-h200-3 benchmarks/june/precision/profile_roofline.job

N=${N:-400}
C=/storage/apps/opt/spack/opt/spack/linux-x86_64_v3/cuda-12.5.1-3qn57icowfxzh7tqp6i3ed2syfz5m4ex
cd /storage/home/lupeterm/NeoFOAM
source "${WM_PROJECT_DIR:-/storage/home/lupeterm/openfoam-OpenFOAM-v2412}/etc/bashrc"
out="benchmarks/june/precision/roofline/h200"
mkdir -p "$out"
./xbuild.sh gpu
bin="$PWD/build/julia-$(hostname -s)-gpu/bin/tests/cavity"
nvidia-smi --query-gpu=name,memory.total,driver_version,clocks.max.sm,clocks.max.mem --format=csv | tee "$out/gpu.txt"
grep RmProfilingAdminOnly /proc/driver/nvidia/params

export JUNE_MODULE_INIT=/storage/home/lupeterm/JuNe.jl/init.jl JULIA_NUM_THREADS=1
export CAVITY_PRECISION=1 CAVITY_DDT=1 CAVITY_MATRIX=scalar CAVITY_RUNS=2
export CAVITY_ONLY="JuNe face-based,JuNe cell-based,JuNe batched" PRECISION_CONFIGS=fp64,fp32,fp16,bf16
ranges=()
for s in face-based cell-based batched; do for p in fp64 fp32 fp16 bf16; do ranges+=(--nvtx-include "precision $s $p/"); done; done
ops=""; for t in d f h; do for o in add mul fma; do ops+="sm__sass_thread_inst_executed_op_${t}${o}_pred_on.sum,"; done; done
peaks="sm__sass_thread_inst_executed_op_dfma_pred_on.sum.peak_sustained,sm__sass_thread_inst_executed_op_ffma_pred_on.sum.peak_sustained,sm__sass_thread_inst_executed_op_hfma_pred_on.sum.peak_sustained,dram__bytes.sum.peak_sustained,sm__cycles_elapsed.avg.per_second,dram__cycles_elapsed.avg.per_second"
metrics="gpu__time_duration.sum,dram__bytes_read.sum,dram__bytes_write.sum,lts__t_bytes.sum,${ops}${peaks}"
echo "=== ncu ${N}^3, $(date)"
(cd /storage/home/lupeterm/nobackup/julia/view/base/mesh/$N/case && \
    $C/bin/ncu --nvtx "${ranges[@]}" --metrics "$metrics" -f -o "$OLDPWD/$out/roofline_$N" "$bin") \
    > "$out/ncu_$N.log" 2>&1; echo "ncu exit $?"
grep -E "All tests|FAILED|==PROF== (Report|Error)|ERROR" "$out/ncu_$N.log" | head
$C/bin/ncu --import "$out/roofline_$N.ncu-rep" --page raw --csv --print-nvtx-rename none > "$out/roofline_$N.csv" 2>&1 || true
$C/bin/ncu --import "$out/roofline_$N.ncu-rep" --page raw --csv > "$out/roofline_${N}_nvtx.csv" 2>&1 || true
wc -l "$out"/roofline_${N}*.csv
echo "done $(date)"
